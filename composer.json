{
    "name": "dpt/mcp-phpstan-warm",
    "description": "Warm-process MCP server for PHPStan. Keeps a PHPStan worker alive across calls via its built-in TCP worker protocol — faster than cold CLI invocations. Compatible with any MCP client (Claude Desktop, Cline, Continue, Zed, custom).",
    "type": "project",
    "license": "proprietary",
    "keywords": ["mcp", "model-context-protocol", "phpstan", "php", "static-analysis", "claude", "ai-tools"],
    "homepage": "https://github.com/Digital-Process-Tools/mcp-phpstan-warm",
    "require": {
        "php": ">=8.2",
        "mcp/sdk": "^0.5",
        "phpstan/phpstan": "^2.0",
        "symfony/finder": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Dpt\\McpPhpstanWarm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dpt\\McpPhpstanWarm\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/mcp-phpstan-warm"],
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^10 || ^11 || ^12"
    }
}
